import socket

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect(('127.0.0.1', 12345))

while True:
    msg = input("Client: ")
    s.send(msg.encode())

    if msg.lower() == "exit":
        break

    reply = s.recv(1024).decode()
    print("Server:", reply)

    if reply.lower() == "exit":
        break

s.close()

