import time, os

expected = 1
last_data = ""

while True:
    if os.path.exists("Sender_Buffer"):
        with open("Sender_Buffer", "r") as f:
            data = f.read()

        if data and data != last_data:
            last_data = data

            for line in data.strip().split("\n"):
                n, ch = line.split(",")

                if int(n) == expected:
                    print("Received:", n, ch)
                    expected += 1
                else:
                    print("NACK:", expected)
                    break

            with open("Receiver_Buffer", "w") as f:
                f.write(str(expected))

    time.sleep(1)
