import time

msg = input("Enter message: ")
w = int(input("Enter window size: "))
i = 0

while i < len(msg):
    end = min(i+w, len(msg))

    with open("Sender_Buffer", "w") as f:
        for n in range(i, end):
            f.write(f"{n+1},{msg[n]}\n")
            print("Sent:", n+1, msg[n])

    while True:
        time.sleep(2)

        with open("Receiver_Buffer", "r") as f:
            ack = int(f.read())

        if ack == end+1:
            print("ACK received:", ack)
            i = end
            break
        else:
            print("NACK received. Resending...")

print("Transmission completed!")
