server.py:

import socket

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

s.bind(('127.0.0.1', 12345))
s.listen(1)

print("Server is waiting...")

conn, addr = s.accept()
print("Client connected:", addr)

while True:
    data = conn.recv(1024)

    if not data:
        break

    print("Client:", data.decode())
    conn.send(data)

conn.close()
s.close()
