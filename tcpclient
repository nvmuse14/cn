import socket

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

s.connect(('127.0.0.1', 12345))

while True:
    msg = input("Enter message: ")

    if msg.lower() == "exit":
        break

    s.send(msg.encode())

    data = s.recv(1024)
    print("Echo from server:", data.decode())

s.close()

